#include "resource.h"
#include <windows.h>

IDI_APP_ICON ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,3,4,0
PRODUCTVERSION  1,3,4,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "VoiceForge Systems"
            VALUE "FileDescription",  "VoiceForge Master Studio"
            VALUE "FileVersion",      "1.3.4.0"
            VALUE "InternalName",     "VoiceForgeStudio"
            VALUE "OriginalFilename", "VoiceForgeStudio.exe"
            VALUE "ProductName",      "VoiceForge Master Studio"
            VALUE "ProductVersion",   "1.3.4.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
